# Copy to .env for local development. On Vercel, add the same names under
# Project → Settings → Environment Variables.

# MongoDB Atlas: either the full connection string...
MONGODB_URI=
# ...or the user + password for the default cluster
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# Firebase Admin service account as ONE base64 line (production).
# Locally the JSON key file next to index.js is used when this is empty.
FB_SERVICE_KEY=

# Stripe secret key (test mode: sk_test_...)
STRIPE_SECRET_KEY=your_stripe_secret_key

# The website address: Stripe returns customers here after paying
PAY_DOMAIN=http://localhost:5173
# Websites allowed to call this API (comma separated). Empty = allow any (dev only)
CLIENT_URL=http://localhost:5173

# Parcel costs are in taka; Stripe charges USD at this rate
BDT_PER_USD=120

# Local port (Vercel ignores it)
PORT=3000
